            "description": "Criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receivable"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URI relativa para consultar o cadastro",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Identificação duplicada; não sobrescreve",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro técnico; sem dados internos na resposta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/receivables/{id}": {
      "put": {
        "summary": "Editar somente recebível PENDING",
        "description": "Substitui valor, tipo, vencimento e moeda. Cedente/código/status não são alteráveis. Usa o mesmo bloqueio FOR UPDATE NOWAIT da liquidação. Edição não exige cotação. Após salvar, obter nova simulação; condições divergentes são rejeitadas na liquidação. Sem versionamento entre duas edições: a última edição aceita prevalece. Em resposta perdida, consultar GET antes de repetir.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Simulate" } } } },
        "responses": {
          "200": { "description": "Cadastro atualizado; nenhuma liquidação realizada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Receivable" } } } },
          "400": { "description": "Campos inválidos, valor ou prazo fora dos limites" },
          "404": { "description": "Título não encontrado" },
          "409": { "description": "ALREADY_SETTLED ou OPERATION_IN_PROGRESS; não altera o título" },
          "500": { "description": "Falha técnica; consultar cadastro antes de repetir" }
        }
      },
      "get": {
        "summary": "Consultar por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cadastro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receivable"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro técnico; sem dados internos na resposta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/exchange-rates": {
