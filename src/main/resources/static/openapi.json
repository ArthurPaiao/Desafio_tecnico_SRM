    "/simulations": {
      "post": {
        "summary": "Simular sem persistir",
        "description": "Lê configuração atual do banco. USD usa a última cotação com validFrom <= calculatedAt; exige calculatedAt < validFrom + validade (seed 24h). Não recorre a cotação anterior. BRL não consulta câmbio. Divide VP BRL já arredondado pela cotação e arredonda USD com HALF_EVEN. Nenhuma garantia de condições para liquidação futura.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Simulate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado informativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Simulation"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Cotação indisponível ou expirada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro técnico; sem dados internos na resposta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/settlements": {
      "post": {
        "summary": "Liquidar integralmente com idempotência e reconfirmação",
        "description": "Primeira execução 201; repetição semanticamente igual da chave/pedido concluído 200, antes de recalcular/validar câmbio. Mesma chave com pedido diferente: 409 IDEMPOTENCY_CONFLICT. Outra chave para SETTLED: 409 ALREADY_SETTLED. Concorrência em andamento: 409 OPERATION_IN_PROGRESS; não mudar chave/payload ao repetir. Divergência financeira: 409 CONDITIONS_CHANGED com current; confirmar novamente é uma nova intenção/chave. Chaves de operações concluídas ficam retidas sem TTL. Nenhuma transferência bancária real.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID gerado pelo cliente uma vez por intenção; reutilizar em resultado incerto."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettlementRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replay da liquidação original",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settlement"
                }
              }
            }
          },
          "201": {
            "description": "Liquidação criada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settlement"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "URI relativa para consulta"
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recebível não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflito; CONDITIONS_CHANGED inclui current. OPERATION_IN_PROGRESS preserva a intenção para retry manual.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/ConditionsError"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Cotação ausente/expirada impede liquidação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Falha técnica; não presumir resultado pelo status de rede",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Consultar snapshots de liquidações por settledAt e id decrescentes",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "Índice base zero. page × size deve ser <= 2147483647."
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Início inclusivo em settledAt. ISO 8601 com horário e offset; anos 0001–9999, precisão máxima de microssegundos.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Fim exclusivo em settledAt. Mesma precisão de from; deve ser posterior ao início quando ambos são informados.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "assignorId",
            "in": "query",
            "required": false,
            "description": "ID do cedente registrado no snapshot.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "Moeda de pagamento do snapshot.",
            "schema": {
              "type": "string",
              "enum": [
                "BRL",
                "USD"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettlementPage"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro técnico; sem dados internos na resposta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Filtros opcionais combináveis. Não recalcula históricos. Cedente inexistente ou página sem resultados retorna 200 com content vazio. Paginação por offset não congela a coleção entre requisições."
      }
    },
