{
  "openapi": "3.1.0",
  "info": {
    "title": "SRM Credit Engine",
    "version": "0.5.0",
    "description": "Cadastro, prévia CSV, consulta, simulação e liquidação individual com idempotência. Valores decimais em strings. Data de negócio America/Sao_Paulo. Ambiente demonstrativo local sem autenticação; não expor publicamente."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/receivables/import-preview": {
      "post": {
        "summary": "Validar CSV sem persistir títulos",
        "description": "UTF-8 (BOM opcional), delimitador ;, aspas CSV, decimal com vírgula sem milhar, data DD/MM/AAAA. Cabeçalhos cedente_codigo;titulo_codigo;tipo;valor_face;vencimento;moeda_pagamento, reordenáveis, sem extras/duplicados. Máximo 256 KB e 100 títulos por padrão (CSV_MAX_ROWS). Linhas inválidas contam; arquivo excessivo ou malformado é rejeitado por inteiro. Todas as ocorrências de cedente/título repetido são inválidas. A confirmação usa POST /receivables para cada linha selecionada, revalidando regras e unicidade. Nenhuma liquidação automática ou armazenamento de CSV.",
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string", "format": "binary" } } } } } },
        "responses": {
          "200": { "description": "Prévia, inclusive erros por linha; request é null para linhas inválidas", "content": { "application/json": { "schema": {
            "type": "object", "required": ["maxRows", "rows"], "properties": {
              "maxRows": { "type": "integer", "minimum": 1 },
              "rows": { "type": "array", "items": { "type": "object", "required": ["line", "values", "request", "errors"], "properties": {
                "line": { "type": "integer", "description": "Linha física inicial do registro; cabeçalho na linha 1" },
                "values": { "type": "array", "items": { "type": "string" }, "minItems": 6, "maxItems": 6, "description": "Valores normalizados na ordem dos cabeçalhos documentados" },
                "request": { "anyOf": [{ "$ref": "#/components/schemas/CreateReceivable" }, { "type": "null" }] },
                "errors": { "type": "array", "items": { "type": "string" } }
              } } }
            }
          } } } },
          "400": { "description": "Arquivo vazio, UTF-8/estrutura inválidos ou limite de títulos excedido" },
          "413": { "description": "Arquivo ou requisição excede o limite de upload" },
          "500": { "description": "Falha técnica; nenhuma linha foi cadastrada pela prévia" }
        }
      }
    },
    "/assignors": {
      "get": {
        "summary": "Listar cedentes por código crescente",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "Índice base zero. page × size deve ser <= 2147483647."
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssignorPage"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro técnico; sem dados internos na resposta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/receivables": {
